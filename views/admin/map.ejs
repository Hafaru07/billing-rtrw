              <tr>
                <th><%= t('admin.map.odp_list.name', 'Nama') %></th>
                <th class="odps-hide-sm"><%= t('admin.map.odp_list.coord', 'Koordinat') %></th>
                <th style="width: 96px; text-align: right;"><%= t('admin.map.odp_list.action', 'Aksi') %></th>
              </tr>
