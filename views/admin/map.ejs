      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('editPoleModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><%= t('admin.map.pole_modal.update', 'Update Tiang') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Drawing Jalur Kabel -->
<div class="mo" id="cablePathModal">
  <div class="mb" style="max-width: 900px;">
    <div class="mh">
      <span class="mt"><i class="bi bi-pencil-fill"></i> Gambar Jalur Kabel</span>
      <button type="button" class="mc" onclick="closeModal('cablePathModal')">&times;</button>
    </div>
    <div class="mbody">
      <div id="cable-drawing-map"></div>
      <p class="text-muted mt-2 small"><i class="bi bi-info-circle"></i> Tarik titik oranye untuk mengubah jalur. Klik pada garis untuk menambah titik lekukan baru.</p>
    </div>
    <div class="mf">
      <button type="button" class="btn btn-sm btn-outline-primary" onclick="addMorePoints()"><i class="bi bi-plus-circle"></i> Tambah Titik Lekukan</button>
      <button type="button" class="btn btn-g" onclick="closeModal('cablePathModal')">Batal</button>
      <button type="button" class="btn btn-p" onclick="saveCablePath()">Simpan Jalur Kabel</button>
    </div>
  </div>
</div>

<script id="settings-data" type="application/json"><%- JSON.stringify(settings) %></script>
<script id="customers-data" type="application/json"><%- JSON.stringify(customers).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="odps-data" type="application/json"><%- JSON.stringify(odps).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="servers-data" type="application/json"><%- JSON.stringify(locals.servers || []).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script id="poles-data" type="application/json"><%- JSON.stringify(locals.poles || []).replace(/<\/script/g, '<\\/script').replace(/<!--/g, '<\\!--') %></script>
<script>
  const I18N = {
    layerOsm: "<%= t('admin.map.layers.osm', 'OpenStreetMap') %>",
    layerHybrid: "<%= t('admin.map.layers.hybrid', 'Satelit (Hybrid)') %>",
    popupDescription: "<%= t('admin.map.popup.description', 'Deskripsi') %>",
    popupLocation: "<%= t('admin.map.popup.location', 'Lokasi') %>",
    popupEdit: "<%= t('common.edit', 'Edit') %>",
    popupStatus: "<%= t('admin.map.popup.status', 'Status') %>",
    popupPackage: "<%= t('admin.map.popup.package', 'Paket') %>",
    popupAddress: "<%= t('admin.map.popup.address', 'Alamat') %>",
    viewDetails: "<%= t('admin.map.popup.view_details', 'Lihat Detail') %>",
    statusActive: "<%= t('admin.map.status.active', 'Aktif') %>",
    statusSuspended: "<%= t('admin.map.status.suspended', 'Isolir') %>"
  };

  const appSettings = JSON.parse(document.getElementById('settings-data').textContent);
  const officeCoords = {
    lat: parseFloat(appSettings.office_lat) || -6.200000,
    lng: parseFloat(appSettings.office_lng) || 106.816666
  };

  // Initialize Map
  const map = L.map('map', {
    editable: true
  }).setView([officeCoords.lat, officeCoords.lng], 13);

  let currentEditingPolyline = null;
  let currentEditingCustomer = null;
  let currentEditingNode = null; // { type: 'pole'|'odp', id } untuk jalur backbone

  // Layers
  const osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '© OpenStreetMap'
  });

  const googleHybrid = L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
    maxZoom: 20,
    subdomains: ['mt0', 'mt1', 'mt2', 'mt3'],
    attribution: '© Google Satellite'
  });

  osm.addTo(map);
  googleHybrid.addTo(map);

  const baseMaps = {
    [I18N.layerOsm]: osm,
    [I18N.layerHybrid]: googleHybrid
  };

  L.control.layers(baseMaps).addTo(map);

  let customers = [];
  let odps = [];
  let servers = [];
  let poles = [];
  try {
    customers = JSON.parse(document.getElementById('customers-data').textContent || '[]');
    odps = JSON.parse(document.getElementById('odps-data').textContent || '[]');
    servers = JSON.parse(document.getElementById('servers-data').textContent || '[]');
    poles = JSON.parse(document.getElementById('poles-data').textContent || '[]');
  } catch (e) {
    console.error("Data mapping error:", e);
  }

  // Registry koordinat & marker tiap node, dipakai untuk menggambar garis topologi.
  const odpMarkers = {};    // { [odpId]: { coord: [lat,lng], marker } }
  const serverMarkers = {}; // { [serverId]: { coord: [lat,lng], marker } }
  const poleMarkers = {};   // { [poleId]: { coord: [lat,lng], marker } }

  function escapeHtml(v) {
    return String(v == null ? '' : v)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function coordOf(nodeType, nodeId) {
    const id = Number(nodeId);
    if (!Number.isFinite(id) || !id) return null;
    const reg = nodeType === 'server' ? serverMarkers : nodeType === 'pole' ? poleMarkers : odpMarkers;
    return reg[id] ? reg[id].coord : null;
  }

  /** Ambil uplink efektif ODP: tiang lebih diprioritaskan daripada server. */
  function odpUplink(odp) {
    if (odp.pole_id && poleMarkers[Number(odp.pole_id)]) return { type: 'pole', id: Number(odp.pole_id) };
    if (odp.server_id && serverMarkers[Number(odp.server_id)]) return { type: 'server', id: Number(odp.server_id) };
    return null;
  }

  /** Gambar garis backbone; pakai cable_path tersimpan kalau ada, kalau tidak garis lurus. */
  function drawBackboneLine(fromCoord, toCoord, cablePath, style) {
    let pathCoords = [fromCoord, toCoord];
    if (cablePath) {
      try {
        const parsed = JSON.parse(cablePath);
        if (Array.isArray(parsed) && parsed.length >= 2) pathCoords = parsed;
      } catch (e) { /* pakai garis lurus */ }
    }
    return L.polyline(pathCoords, style).addTo(map);
  }

  // ─── SERVER MARKERS ──────────────────────────────────────────────────────
  const SERVER_TYPE_LABEL = { pop: 'POP / Kantor', olt: 'OLT', router: 'Router', backbone: 'Backbone', bts: 'BTS / Tower' };
  servers.forEach(srv => {
    if (!srv.lat || !srv.lng) return;
    const coord = [parseFloat(srv.lat), parseFloat(srv.lng)];
    const isOn = Number(srv.is_active) === 1;
    const marker = L.marker(coord, {
      zIndexOffset: 1000,
      icon: L.divIcon({
        html: `<i class="bi bi-hdd-network-fill ${isOn ? 'marker-server' : 'marker-server-off'}"></i>`,
        className: 'custom-div-icon',
        iconSize: [22, 22],
        iconAnchor: [11, 11]
      })
    }).addTo(map);

    marker.bindPopup(`
      <div class="popup-content">
        <h6><i class="bi bi-hdd-network-fill" style="color:#8b5cf6"></i> ${escapeHtml(srv.name)}</h6>
        <div><strong>Tipe:</strong> ${escapeHtml(SERVER_TYPE_LABEL[srv.type] || srv.type || '-')}</div>
        <div><strong>Kapasitas:</strong> ${Number(srv.capacity) > 0 ? Number(srv.capacity) + ' port/core' : 'Tak dibatasi'}</div>
        <div><strong>${I18N.popupAddress}:</strong> ${escapeHtml(srv.address || '-')}</div>
        <div><strong>${I18N.popupDescription}:</strong> ${escapeHtml(srv.description || '-')}</div>
        <div><strong>${I18N.popupLocation}:</strong> ${escapeHtml(srv.lat)}, ${escapeHtml(srv.lng)}</div>
        <div class="popup-actions">
          <button class="btn btn-sm btn-p" onclick="editServerById(${Number(srv.id)})">${I18N.popupEdit}</button>
        </div>
      </div>
    `);

    serverMarkers[Number(srv.id)] = { coord, marker };
  });

  // ─── POLE MARKERS ────────────────────────────────────────────────────────
  const POLE_TYPE_LABEL = { beton: 'Beton', besi: 'Besi', kayu: 'Kayu', existing: 'Numpang (PLN/Telkom)' };
  poles.forEach(pole => {
    if (!pole.lat || !pole.lng) return;
    const coord = [parseFloat(pole.lat), parseFloat(pole.lng)];
    const marker = L.marker(coord, {
      zIndexOffset: 500,
      icon: L.divIcon({
        html: '<i class="bi bi-broadcast-pin marker-pole"></i>',
        className: 'custom-div-icon',
        iconSize: [16, 16],
        iconAnchor: [8, 8]
      })
    }).addTo(map);

    marker.bindPopup(`
      <div class="popup-content">
        <h6><i class="bi bi-broadcast-pin" style="color:#10b981"></i> ${escapeHtml(pole.name)}</h6>
        <div><strong>Jenis:</strong> ${escapeHtml(POLE_TYPE_LABEL[pole.type] || pole.type || '-')}</div>
        <div><strong>Induk:</strong> ${escapeHtml(pole.parent_name || 'Tanpa induk')}</div>
        <div><strong>${I18N.popupDescription}:</strong> ${escapeHtml(pole.description || '-')}</div>
        <div><strong>${I18N.popupLocation}:</strong> ${escapeHtml(pole.lat)}, ${escapeHtml(pole.lng)}</div>
        <div class="popup-actions">
          <button class="btn btn-sm btn-p" onclick="editPoleById(${Number(pole.id)})">${I18N.popupEdit}</button>
          ${pole.parent_type && pole.parent_id ? `<button class="btn btn-sm btn-g" onclick="startBackboneDrawing('pole', ${Number(pole.id)})"><i class="bi bi-pencil-fill"></i> Gambar Jalur</button>` : ''}
        </div>
      </div>
    `);

    poleMarkers[Number(pole.id)] = { coord, marker };
  });

  // ─── GARIS: TIANG -> INDUK (server / tiang lain) ─────────────────────────
  poles.forEach(pole => {
    const from = coordOf('pole', pole.id);
    if (!from || !pole.parent_type || !pole.parent_id) return;
    const to = coordOf(pole.parent_type, pole.parent_id);
    if (!to) return;
    drawBackboneLine(from, to, pole.cable_path, {
      color: '#8b5cf6',
      weight: 4,
      opacity: 0.85,
      dashArray: '12, 6',
      className: 'flowing-line'
    });
  });

  // ─── ODP MARKERS + GARIS ODP -> UPLINK ───────────────────────────────────
  odps.forEach(odp => {
    if (!odp.lat || !odp.lng) return;
    const coord = [parseFloat(odp.lat), parseFloat(odp.lng)];
    const marker = L.marker(coord, {
      icon: L.divIcon({
        html: '<i class="bi bi-box-seam-fill marker-odp"></i>',
        className: 'custom-div-icon',
        iconSize: [18, 18],
        iconAnchor: [9, 9]
      })
    }).addTo(map);

    const uplinkName = odp.pole_name || odp.server_name || 'Tanpa induk';
    marker.bindPopup(`
      <div class="popup-content">
        <h6><i class="bi bi-box-seam-fill" style="color:#f59e0b"></i> ${escapeHtml(odp.name)}</h6>
        <div><strong>Induk:</strong> ${escapeHtml(uplinkName)}</div>
        <div><strong>${I18N.popupDescription}:</strong> ${escapeHtml(odp.description || '-')}</div>
        <div><strong>${I18N.popupLocation}:</strong> ${escapeHtml(odp.lat)}, ${escapeHtml(odp.lng)}</div>
        <div class="popup-actions">
          <button class="btn btn-sm btn-p" onclick="editOdpById(${Number(odp.id)})">${I18N.popupEdit}</button>
          ${(odp.pole_id || odp.server_id) ? `<button class="btn btn-sm btn-g" onclick="startBackboneDrawing('odp', ${Number(odp.id)})"><i class="bi bi-pencil-fill"></i> Gambar Jalur</button>` : ''}
        </div>
      </div>
    `);

    odpMarkers[Number(odp.id)] = { coord, marker };
  });

  // Garis digambar setelah semua marker terdaftar supaya uplink pasti ketemu.
  odps.forEach(odp => {
    const from = coordOf('odp', odp.id);
    if (!from) return;
    const up = odpUplink(odp);
    if (!up) return;
    const to = coordOf(up.type, up.id);
    if (!to) return;
    drawBackboneLine(from, to, odp.cable_path, {
      color: '#f59e0b',
      weight: 3.5,
      opacity: 0.85,
      dashArray: '10, 6',
      className: 'flowing-line'
    });
  });

  // Add Customer Markers
  customers.forEach(cust => {
    if (cust.lat && cust.lng) {
      const is_active = cust.status === 'active';
      const iconClass = is_active ? 'marker-cust-active' : 'marker-cust-suspended';
      const downMaxMbps = (cust.speed_down && Number(cust.speed_down) > 0) ? Math.max(1, Math.round(Number(cust.speed_down) / 1000)) : 10;
      const upMaxMbps = (cust.speed_up && Number(cust.speed_up) > 0) ? Math.max(1, Math.round(Number(cust.speed_up) / 1000)) : 10;
      const waLink = buildWaLink(cust.phone, cust.name);
      const mapsLink = buildMapsLink(cust.lat, cust.lng);
      
      // Draw line to ODP if connected
      const custOdpCoord = coordOf('odp', cust.odp_id);
      if (custOdpCoord) {
        let pathCoords = [[parseFloat(cust.lat), parseFloat(cust.lng)], custOdpCoord];

        if (cust.cable_path) {
          try {
            pathCoords = JSON.parse(cust.cable_path);
          } catch(e) {}
        }

        const polyline = L.polyline(pathCoords, {
          color: is_active ? '#3b82f6' : '#ef4444',
          weight: 3,
          opacity: 0.8,
          dashArray: '10, 10',
          className: 'flowing-line'
        }).addTo(map);

        polyline.on('click', (e) => {
          if (currentEditingPolyline === polyline) {
             L.DomEvent.stopPropagation(e);
          }
        });
      }

      const marker = L.marker([cust.lat, cust.lng], {
        icon: L.divIcon({
          html: `<i class="bi bi-person-fill ${iconClass}"></i>`,
          className: 'custom-div-icon',
          iconSize: [20, 20],
          iconAnchor: [10, 10]
        })
      }).addTo(map);

      marker.bindPopup(`
        <div class="cust-popup">
          <div class="cp-head">
            <div class="cp-avatar"><i class="bi bi-person-fill"></i></div>
            <div class="cp-title">
              <div class="cp-name">${cust.name}</div>
              <div class="cp-badges">
                <span class="cp-chip ${is_active ? 'cp-chip-active' : 'cp-chip-suspended'}"><i class="bi bi-shield-check"></i>${is_active ? I18N.statusActive : I18N.statusSuspended}</span>
                <span class="cp-chip"><i class="bi bi-box-seam"></i>${cust.package_name || '-'}</span>
              </div>
            </div>
          </div>

          <div class="cp-meta">
            <div class="cp-meta-item"><i class="bi bi-router"></i><span>${cust.pppoe_username || '-'}</span></div>
            <div class="cp-meta-item"><i class="bi bi-tag"></i><span>${cust.genieacs_tag || '-'}</span></div>
            <div class="cp-meta-item"><i class="bi bi-receipt"></i><span>${Number(cust.unpaid_count || 0)} belum bayar</span></div>
            <div class="cp-meta-item"><i class="bi bi-geo-alt"></i><span>${cust.address || '-'}</span></div>
          </div>

          <div class="cp-traffic">
            <div class="cp-traffic-head"><i class="bi bi-activity"></i><span>Trafik Realtime</span></div>
            <div class="cp-traffic-grid">
              <div class="cp-chart">
                <div class="cp-chart-label"><i class="bi bi-download"></i><span>Download</span></div>
                <canvas class="cp-spark" id="cust_${cust.id}_dl_chart" width="160" height="70" data-max="${downMaxMbps}"></canvas>
                <div class="cp-overlay" id="cust_${cust.id}_dl_state"></div>
              </div>
              <div class="cp-chart">
                <div class="cp-chart-label"><i class="bi bi-upload"></i><span>Upload</span></div>
                <canvas class="cp-spark" id="cust_${cust.id}_ul_chart" width="160" height="70" data-max="${upMaxMbps}"></canvas>
                <div class="cp-overlay" id="cust_${cust.id}_ul_state"></div>
              </div>
            </div>
          </div>

          <div class="popup-actions">
             <button onclick="startCableDrawing(${cust.id}, ${cust.lat}, ${cust.lng}, ${cust.odp_id})" class="btn btn-sm btn-p"><i class="bi bi-pencil-fill me-1"></i>Gambar Jalur</button>
             <a href="/admin/customers?search=${encodeURIComponent(cust.name || '')}" class="btn btn-sm btn-g"><i class="bi bi-eye me-1"></i>Detail</a>
             <a href="${waLink}" target="_blank" class="btn btn-sm btn-wa"><i class="bi bi-whatsapp"></i></a>
          </div>
        </div>
      `);

      marker.on('popupopen', () => startCustomerTrafficPopup(cust.id));
      marker.on('popupclose', () => stopCustomerTrafficPopup(cust.id));
    }
  });

  // Cable Drawing Modal Map
  let drawingMap, drawingPolyline, drawingMarkers = [];
  
  function interpolatePoints(p1, p2, count) {
    const points = [p1];
    for (let i = 1; i <= count; i++) {
      const lat = p1[0] + (p2[0] - p1[0]) * (i / (count + 1));
      const lng = p1[1] + (p2[1] - p1[1]) * (i / (count + 1));
      points.push([lat, lng]);
    }
    points.push(p2);
    return points;
  }

  function renderEditorMarkers() {
    // Clear old markers
    drawingMarkers.forEach(m => drawingMap.removeLayer(m));
    drawingMarkers = [];

    const latlngs = drawingPolyline.getLatLngs();
    
    latlngs.forEach((ll, index) => {
      const isEdge = index === 0 || index === latlngs.length - 1;
      
      const marker = L.marker(ll, {
        draggable: true,
        zIndexOffset: 2000,
        icon: L.divIcon({
          html: `<div style="background: ${isEdge ? '#3b82f6' : '#ff0000'}; width: 16px; height: 16px; border-radius: 50%; border: 2px solid white; box-shadow: 0 0 5px rgba(0,0,0,0.5);"></div>`,
          className: 'custom-div-icon',
          iconSize: [16, 16],
          iconAnchor: [8, 8]
        })
      }).addTo(drawingMap);

      marker.on('drag', (e) => {
        const newLatLngs = drawingPolyline.getLatLngs();
        newLatLngs[index] = e.latlng;
        drawingPolyline.setLatLngs(newLatLngs);
      });

      drawingMarkers.push(marker);
    });
  }

  function startCableDrawing(customerId, lat, lng, odpId) {
    const odpCoord = coordOf('odp', odpId);
    if (!odpCoord) return alert('Data ODP tidak ditemukan');

    currentEditingCustomer = customerId;
    currentEditingNode = null; // mode pelanggan
    openModal('cablePathModal');

    setTimeout(() => {
      try {
        if (drawingMap) drawingMap.remove();
        
        drawingMap = L.map('cable-drawing-map').setView([lat, lng], 17);
        
        L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
          maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
        }).addTo(drawingMap);

        const customer = customers.find(c => c.id === customerId);
        let pathCoords = [];
        if (customer && customer.cable_path) {
          try { pathCoords = JSON.parse(customer.cable_path); } catch(e) {}
        }
        
        if (pathCoords.length <= 2) {
          pathCoords = interpolatePoints([parseFloat(lat), parseFloat(lng)], odpCoord, 5);
        }

        drawingPolyline = L.polyline(pathCoords, {
          color: '#f59e0b', weight: 6, dashArray: '5, 5', interactive: false
        }).addTo(drawingMap);

        renderEditorMarkers();

        setTimeout(() => {
          drawingMap.invalidateSize();
          drawingMap.fitBounds(drawingPolyline.getBounds(), { padding: [50, 50] });
        }, 200);

      } catch (err) {
        console.error("Drawing map error:", err);
      }
    }, 600);
  }

  function addMorePoints() {
    if (!drawingPolyline || !drawingMap) return;
    const latlngs = drawingPolyline.getLatLngs();
    const newPath = [];
    for (let i = 0; i < latlngs.length - 1; i++) {
      newPath.push(latlngs[i]);
      const midLat = (latlngs[i].lat + latlngs[i+1].lat) / 2;
      const midLng = (latlngs[i].lng + latlngs[i+1].lng) / 2;
      newPath.push(L.latLng(midLat, midLng));
    }
    newPath.push(latlngs[latlngs.length - 1]);
    drawingPolyline.setLatLngs(newPath);
    renderEditorMarkers();
  }

  /**
   * Editor jalur kabel untuk node backbone (tiang / ODP) ke uplink-nya.
   * Memakai modal & polyline editor yang sama dengan jalur pelanggan.
   */
  function startBackboneDrawing(nodeType, nodeId) {
    const id = Number(nodeId);
    const node = nodeType === 'pole'
      ? poles.find(p => Number(p.id) === id)
      : odps.find(o => Number(o.id) === id);
    if (!node) return alert('Data node tidak ditemukan');

    const fromCoord = coordOf(nodeType, id);
    if (!fromCoord) return alert('Koordinat node belum diisi');

    const up = nodeType === 'pole'
      ? (node.parent_type && node.parent_id ? { type: node.parent_type, id: Number(node.parent_id) } : null)
      : odpUplink(node);
    if (!up) return alert('Node ini belum punya induk (uplink). Set induknya dulu lewat Edit.');

    const toCoord = coordOf(up.type, up.id);
    if (!toCoord) return alert('Koordinat induk belum diisi');

    currentEditingCustomer = null;
    currentEditingNode = { type: nodeType, id };
    openModal('cablePathModal');

    setTimeout(() => {
      try {
        if (drawingMap) drawingMap.remove();
        drawingMap = L.map('cable-drawing-map').setView(fromCoord, 17);
        L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
          maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
        }).addTo(drawingMap);

        let pathCoords = [];
        if (node.cable_path) {
          try { pathCoords = JSON.parse(node.cable_path); } catch (e) {}
        }
        if (!Array.isArray(pathCoords) || pathCoords.length <= 2) {
          pathCoords = interpolatePoints(fromCoord, toCoord, 5);
        }

        drawingPolyline = L.polyline(pathCoords, {
          color: nodeType === 'pole' ? '#8b5cf6' : '#f59e0b',
          weight: 6, dashArray: '5, 5', interactive: false
        }).addTo(drawingMap);

        renderEditorMarkers();

        setTimeout(() => {
          drawingMap.invalidateSize();
          drawingMap.fitBounds(drawingPolyline.getBounds(), { padding: [50, 50] });
        }, 200);
      } catch (err) {
        console.error('Backbone drawing map error:', err);
      }
    }, 600);
  }

  async function saveCablePath() {
    if (!drawingPolyline) return;
    if (!currentEditingCustomer && !currentEditingNode) return;

    const latlngs = drawingPolyline.getLatLngs().map(ll => [ll.lat, ll.lng]);
    const pathJson = JSON.stringify(latlngs);

    let endpoint;
    if (currentEditingNode) {
      const seg = currentEditingNode.type === 'pole' ? 'poles' : 'odps';
      endpoint = `/admin/api/${seg}/${currentEditingNode.id}/cable-path`;
    } else {
      endpoint = `/admin/api/customers/${currentEditingCustomer}/cable-path`;
    }

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ path: pathJson })
      });

      const contentType = res.headers.get("content-type");
      if (contentType && contentType.indexOf("application/json") !== -1) {
        const data = await res.json();
        if (data.ok) {
          alert('Jalur kabel berhasil disimpan!');
          location.reload();
        } else {
          alert('Gagal menyimpan: ' + data.error);
        }
      } else {
        const text = await res.text();
        console.error("Server returned non-JSON response:", text);
        alert('Gagal menyimpan: Server mengembalikan respon tidak valid (HTML/404). Periksa konsol browser.');
      }
    } catch (e) {
      alert('Error: ' + e.message);
    }
  }

  // Modal functions
  let pickerMap, pickerMarker;
  let editPickerMap, editPickerMarker;

  function initPickerMap(lat, lng) {
    if (!pickerMap) {
      pickerMap = L.map('picker-map').setView([lat, lng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(pickerMap);
      
      const odpIcon = L.divIcon({
        html: '<i class="bi bi-box-seam-fill picker-icon-odp"></i>',
        className: 'custom-div-icon',
        iconSize: [24, 24],
        iconAnchor: [12, 12]
      });

      pickerMarker = L.marker([lat, lng], { 
        draggable: true,
        icon: odpIcon
      }).addTo(pickerMap);
      
      pickerMarker.on('dragend', function(e) {
        const pos = pickerMarker.getLatLng();
        document.getElementById('new_lat').value = pos.lat.toFixed(6);
        document.getElementById('new_lng').value = pos.lng.toFixed(6);
      });

      pickerMap.on('click', function(e) {
        pickerMarker.setLatLng(e.latlng);
        document.getElementById('new_lat').value = e.latlng.lat.toFixed(6);
        document.getElementById('new_lng').value = e.latlng.lng.toFixed(6);
      });
    } else {
      pickerMap.setView([lat, lng], 16);
      pickerMarker.setLatLng([lat, lng]);
    }
    setTimeout(() => pickerMap.invalidateSize(), 300);
  }

  function initEditPickerMap(lat, lng) {
    if (!editPickerMap) {
      editPickerMap = L.map('edit-picker-map').setView([lat, lng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(editPickerMap);
      
      const odpIcon = L.divIcon({
        html: '<i class="bi bi-box-seam-fill picker-icon-odp"></i>',
        className: 'custom-div-icon',
        iconSize: [24, 24],
        iconAnchor: [12, 12]
      });

      editPickerMarker = L.marker([lat, lng], { 
        draggable: true,
        icon: odpIcon
      }).addTo(editPickerMap);
      
      editPickerMarker.on('dragend', function(e) {
        const pos = editPickerMarker.getLatLng();
        document.getElementById('e_odp_lat').value = pos.lat.toFixed(6);
        document.getElementById('e_odp_lng').value = pos.lng.toFixed(6);
      });

      editPickerMap.on('click', function(e) {
        editPickerMarker.setLatLng(e.latlng);
        document.getElementById('e_odp_lat').value = e.latlng.lat.toFixed(6);
        document.getElementById('e_odp_lng').value = e.latlng.lng.toFixed(6);
      });
    } else {
      editPickerMap.setView([lat, lng], 16);
      editPickerMarker.setLatLng([lat, lng]);
    }
    setTimeout(() => editPickerMap.invalidateSize(), 300);
  }

  /**
   * Picker peta generik untuk modal server & tiang.
   * Menyimpan instance per-container agar tidak diinisialisasi ulang.
   */
  const genericPickers = {};

  function initGenericPicker(containerId, latInputId, lngInputId, iconClass, lat, lng) {
    const startLat = parseFloat(lat) || officeCoords.lat;
    const startLng = parseFloat(lng) || officeCoords.lng;
    const existing = genericPickers[containerId];

    if (!existing) {
      const m = L.map(containerId).setView([startLat, startLng], 16);
      L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', {
        maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
      }).addTo(m);

      const mk = L.marker([startLat, startLng], {
        draggable: true,
        icon: L.divIcon({
          html: `<i class="${iconClass}"></i>`,
          className: 'custom-div-icon',
          iconSize: [26, 26],
          iconAnchor: [13, 13]
        })
      }).addTo(m);

      const writeCoords = (ll) => {
        document.getElementById(latInputId).value = ll.lat.toFixed(6);
        document.getElementById(lngInputId).value = ll.lng.toFixed(6);
      };

      mk.on('dragend', () => writeCoords(mk.getLatLng()));
      m.on('click', (e) => { mk.setLatLng(e.latlng); writeCoords(e.latlng); });

      genericPickers[containerId] = { map: m, marker: mk };
    } else {
      existing.map.setView([startLat, startLng], 16);
      existing.marker.setLatLng([startLat, startLng]);
    }
    setTimeout(() => genericPickers[containerId].map.invalidateSize(), 300);
  }

  function openModal(id) {
    document.getElementById(id).style.display = 'flex';
    if (id === 'addOdpModal') {
      const lat = document.getElementById('new_lat').value || officeCoords.lat;
      const lng = document.getElementById('new_lng').value || officeCoords.lng;
      initPickerMap(lat, lng);
    } else if (id === 'addServerModal') {
      initGenericPicker('server-picker-map', 'new_server_lat', 'new_server_lng', 'bi bi-hdd-network-fill picker-icon-server',
        document.getElementById('new_server_lat').value, document.getElementById('new_server_lng').value);
    } else if (id === 'addPoleModal') {
      initGenericPicker('pole-picker-map', 'new_pole_lat', 'new_pole_lng', 'bi bi-broadcast-pin picker-icon-pole',
        document.getElementById('new_pole_lat').value, document.getElementById('new_pole_lng').value);
    }
  }

  function closeModal(id) { document.getElementById(id).style.display = 'none'; }

  /** Pecah nilai select "tipe:id" ke dua hidden input server_id / pole_id. */
  function syncOdpUplink(select, serverInputId, poleInputId) {
    const [type, id] = String(select.value || '').split(':');
    document.getElementById(serverInputId).value = type === 'server' ? (id || '') : '';
    document.getElementById(poleInputId).value = type === 'pole' ? (id || '') : '';
  }

  /** Pecah nilai select "tipe:id" ke hidden input parent_type / parent_id. */
  function syncPoleParent(select, typeInputId, idInputId) {
    const [type, id] = String(select.value || '').split(':');
    document.getElementById(typeInputId).value = type || '';
    document.getElementById(idInputId).value = id || '';
  }

  function switchNodeTab(btn) {
    document.querySelectorAll('.node-tab').forEach(b => b.classList.toggle('on', b === btn));
    const target = btn.dataset.pane;
    document.querySelectorAll('.node-pane').forEach(p => p.classList.toggle('on', p.id === target));
  }

  function focusNode(nodeType, id) {
    const reg = nodeType === 'server' ? serverMarkers : nodeType === 'pole' ? poleMarkers : odpMarkers;
    const entry = reg[Number(id)];
    if (!entry || !entry.marker) return;
    map.setView(entry.marker.getLatLng(), 18, { animate: true });
    try { entry.marker.openPopup(); } catch (e) {}
  }

  function deleteNode(segment, id, label) {
    if (!confirm(`Hapus ${label} ini? Node yang terhubung akan dilepas, bukan ikut terhapus.`)) return;
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/admin/${segment}/${id}/delete`;
    document.body.appendChild(form);
    form.submit();
  }

  function editServerById(id) {
    const srv = servers.find(s => Number(s.id) === Number(id));
    if (!srv) return;
    document.getElementById('editServerForm').action = '/admin/servers/' + srv.id + '/update';
    document.getElementById('e_server_name').value = srv.name || '';
    document.getElementById('e_server_type').value = srv.type || 'pop';
    document.getElementById('e_server_capacity').value = Number(srv.capacity) || 0;
    document.getElementById('e_server_lat').value = srv.lat || '';
    document.getElementById('e_server_lng').value = srv.lng || '';
    document.getElementById('e_server_address').value = srv.address || '';
    document.getElementById('e_server_is_active').value = Number(srv.is_active) === 1 ? '1' : '0';
    document.getElementById('e_server_description').value = srv.description || '';
    openModal('editServerModal');
    initGenericPicker('server-edit-picker-map', 'e_server_lat', 'e_server_lng', 'bi bi-hdd-network-fill picker-icon-server', srv.lat, srv.lng);
  }

  function editPoleById(id) {
    const pole = poles.find(p => Number(p.id) === Number(id));
    if (!pole) return;
    document.getElementById('editPoleForm').action = '/admin/poles/' + pole.id + '/update';
    document.getElementById('e_pole_name').value = pole.name || '';
    document.getElementById('e_pole_type').value = pole.type || 'beton';
    document.getElementById('e_pole_lat').value = pole.lat || '';
    document.getElementById('e_pole_lng').value = pole.lng || '';
    document.getElementById('e_pole_description').value = pole.description || '';

    // Sembunyikan diri sendiri dari daftar induk supaya tidak bisa jadi induk sendiri.
    const parentSelect = document.getElementById('e_pole_parent');
    Array.from(parentSelect.options).forEach(opt => {
      opt.hidden = opt.value === `pole:${pole.id}`;
    });
    parentSelect.value = (pole.parent_type && pole.parent_id) ? `${pole.parent_type}:${pole.parent_id}` : '';
    syncPoleParent(parentSelect, 'e_pole_parent_type', 'e_pole_parent_id');

    openModal('editPoleModal');
    initGenericPicker('pole-edit-picker-map', 'e_pole_lat', 'e_pole_lng', 'bi bi-broadcast-pin picker-icon-pole', pole.lat, pole.lng);
  }

  function editOdp(odp) {
    document.getElementById('editOdpForm').action = '/admin/odps/' + odp.id + '/update';
    document.getElementById('e_odp_name').value = odp.name;
    document.getElementById('e_odp_lat').value = odp.lat;
    document.getElementById('e_odp_lng').value = odp.lng;
    document.getElementById('e_odp_description').value = odp.description || '';

    const uplinkSelect = document.getElementById('e_odp_uplink');
    if (odp.pole_id) uplinkSelect.value = `pole:${odp.pole_id}`;
    else if (odp.server_id) uplinkSelect.value = `server:${odp.server_id}`;
    else uplinkSelect.value = '';
    syncOdpUplink(uplinkSelect, 'e_odp_server_id', 'e_odp_pole_id');

    openModal('editOdpModal');
    initEditPickerMap(odp.lat, odp.lng);
  }

  function editOdpById(id) {
    const n = Number(id);
    if (!Number.isFinite(n) || !odps || !Array.isArray(odps)) return;
    const found = odps.find(o => Number(o.id) === n);
    if (!found) return;
    editOdp(found);
  }

  function editOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    editOdpById(btn.dataset.odpId);
  }

  function deleteOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    const odpId = btn.dataset.odpId;
    if (confirm('Apakah Anda yakin ingin menghapus ODP ini?')) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = `/admin/odps/${odpId}/delete`;
      document.body.appendChild(form);
      form.submit();
    }
  }

  function focusOdpFromBtn(btn) {
    if (!btn || !btn.dataset) return;
    focusOdp(btn.dataset.odpId);
  }

  // Klik kanan pada peta: isi koordinat ke semua form tambah, lalu buka ODP (default).
  // Kalau mau server/tiang, tinggal tutup lalu klik tombol di toolbar — koordinat sudah terisi.
  map.on('contextmenu', function(e) {
    const lat = e.latlng.lat.toFixed(6);
    const lng = e.latlng.lng.toFixed(6);

    [['new_lat', 'new_lng'], ['new_server_lat', 'new_server_lng'], ['new_pole_lat', 'new_pole_lng']].forEach(([latId, lngId]) => {
      const latEl = document.getElementById(latId);
      const lngEl = document.getElementById(lngId);
      if (latEl) latEl.value = lat;
      if (lngEl) lngEl.value = lng;
    });

    openModal('addOdpModal');
  });

  // Auto zoom to markers if exist
  const group = L.featureGroup([...map._layers].filter(l => l instanceof L.Marker || l instanceof L.CircleMarker));
  if (group.getLayers().length > 0) {
    map.fitBounds(group.getBounds().pad(0.1));
  }

  // Fix for blank map on load
  setTimeout(() => {
    map.invalidateSize();
  }, 500);

  window.onclick = function(e) {
    if (e.target.className === 'mo') {
      e.target.style.display = 'none';
    }
  }

  const customerTrafficIntervals = {};
  const customerTrafficSeries = {};

  function focusOdp(id) {
    focusNode('odp', id);
  }

  // Pencarian untuk semua tabel node (server / tiang / ODP)
  (function bindNodeSearches() {
    document.querySelectorAll('input[data-search-for]').forEach(input => {
      const tbody = document.getElementById(input.dataset.searchFor);
      if (!tbody) return;

      function apply() {
        const q = String(input.value || '').trim().toLowerCase();
        tbody.querySelectorAll('tr[data-name]').forEach(r => {
          const name = String(r.getAttribute('data-name') || '');
          r.style.display = !q || name.includes(q) ? '' : 'none';
        });
      }

      input.addEventListener('input', apply);
      apply();
    });
  })();

  function drawSparkline(canvas, series, maxMbps, color) {
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const w = canvas.width;
    const h = canvas.height;
    const padX = 6;
    const padY = 8;
    const innerW = w - padX * 2;
    const innerH = h - padY * 2;
    const max = Number.isFinite(maxMbps) && maxMbps > 0 ? maxMbps : 10;
    let vals = Array.isArray(series) ? series : [];

    ctx.clearRect(0, 0, w, h);

    ctx.strokeStyle = 'rgba(148, 163, 184, 0.22)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let i = 0; i <= 3; i++) {
      const y = padY + (innerH * i) / 3;
      ctx.moveTo(padX, y);
      ctx.lineTo(padX + innerW, y);
    }
    ctx.stroke();

    if (vals.length === 1) vals = [vals[0], vals[0]];
    if (vals.length < 2) return;

    const toY = (v) => {
      const n = Math.max(0, Number(v || 0) || 0);
      const r = Math.min(1, n / max);
      return padY + innerH * (1 - r);
    };

    const grad = ctx.createLinearGradient(padX, padY, padX + innerW, padY);
    grad.addColorStop(0, color);
    grad.addColorStop(1, 'rgba(255,255,255,0.0)');

    ctx.beginPath();
    for (let i = 0; i < vals.length; i++) {
      const x = padX + (innerW * i) / (vals.length - 1);
      const y = toY(vals[i]);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.stroke();

    ctx.lineTo(padX + innerW, padY + innerH);
    ctx.lineTo(padX, padY + innerH);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.globalAlpha = 0.22;
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  function setOverlay(customerId, kind, text) {
    const el = document.getElementById(`cust_${customerId}_${kind}_state`);
    if (!el) return;
    const t = String(text || '').trim();
    el.textContent = t;
    if (t) el.classList.add('on');
    else el.classList.remove('on');
  }

  function updatePopupTraffic(customerId, dlMbps, ulMbps, labelOverride) {
    const dlCanvas = document.getElementById(`cust_${customerId}_dl_chart`);
    const ulCanvas = document.getElementById(`cust_${customerId}_ul_chart`);
    const dlMax = Number(dlCanvas && dlCanvas.dataset ? dlCanvas.dataset.max : 10) || 10;
    const ulMax = Number(ulCanvas && ulCanvas.dataset ? ulCanvas.dataset.max : 10) || 10;

    if (!customerTrafficSeries[customerId]) customerTrafficSeries[customerId] = { dl: [], ul: [] };
    const st = customerTrafficSeries[customerId];

    if (labelOverride) {
      setOverlay(customerId, 'dl', labelOverride);
      setOverlay(customerId, 'ul', labelOverride);
      st.dl = [];
      st.ul = [];
      drawSparkline(dlCanvas, [0, 0], dlMax, 'rgba(59,130,246,0.6)');
      drawSparkline(ulCanvas, [0, 0], ulMax, 'rgba(34,197,94,0.6)');
      return;
    }

    setOverlay(customerId, 'dl', '');
    setOverlay(customerId, 'ul', '');

    const dl = Math.max(0, Number(dlMbps || 0) || 0);
    const ul = Math.max(0, Number(ulMbps || 0) || 0);
    st.dl.push(dl);
    st.ul.push(ul);
    if (st.dl.length > 22) st.dl = st.dl.slice(-22);
    if (st.ul.length > 22) st.ul = st.ul.slice(-22);

    drawSparkline(dlCanvas, st.dl, dlMax, '#3b82f6');
    drawSparkline(ulCanvas, st.ul, ulMax, '#22c55e');
  }

  async function refreshCustomerTrafficPopup(customerId) {
    try {
      const r = await fetch(`/admin/api/customers/${customerId}/pppoe-traffic`, { cache: 'no-store' });
      const data = await r.json();
      if (!data || !data.ok) {
        updatePopupTraffic(customerId, 0, 0, '-');
        return;
      }
      if (!data.available) {
        updatePopupTraffic(customerId, 0, 0, 'N/A');
        return;
      }
      if (!data.online) {
        updatePopupTraffic(customerId, 0, 0, 'Offline');
        return;
      }
      if (data.warmup) {
        updatePopupTraffic(customerId, 0, 0, 'Mengukur');
        return;
      }

      const rx = Number(data.rxMbps || 0);
      const tx = Number(data.txMbps || 0);
      updatePopupTraffic(customerId, tx, rx, '');
    } catch {
      updatePopupTraffic(customerId, 0, 0, '-');
    }
  }

  function startCustomerTrafficPopup(customerId) {
    stopCustomerTrafficPopup(customerId);
    refreshCustomerTrafficPopup(customerId);
    customerTrafficIntervals[customerId] = setInterval(() => refreshCustomerTrafficPopup(customerId), 3000);
  }

  function stopCustomerTrafficPopup(customerId) {
    const t = customerTrafficIntervals[customerId];
    if (t) clearInterval(t);
    delete customerTrafficIntervals[customerId];
  }

  function normalizePhone(phone) {
    const raw = String(phone || '').trim();
    const digits = raw.replace(/\D/g, '');
    if (!digits) return '';
    if (digits.startsWith('62')) return digits;
    if (digits.startsWith('0')) return `62${digits.slice(1)}`;
    if (digits.length >= 9) return `62${digits}`;
    return digits;
  }

  function buildWaLink(phone, name) {
    const to = normalizePhone(phone);
    const msg = `Halo ${String(name || '').trim()}`;
    if (!to) return 'javascript:void(0)';
    return `https://wa.me/${to}?text=${encodeURIComponent(msg)}`;
  }

  function buildMapsLink(lat, lng) {
    const la = Number(lat);
    const lo = Number(lng);
    if (!Number.isFinite(la) || !Number.isFinite(lo)) return 'javascript:void(0)';
    return `https://www.google.com/maps?q=${encodeURIComponent(String(la))},${encodeURIComponent(String(lo))}`;
  }
</script>
