                      <% if (o.pole_name) { %>
                        <div class="odps-badge pole"><i class="bi bi-arrow-up-right"></i><%= o.pole_name %></div>
                      <% } else if (o.server_name) { %>
                        <div class="odps-badge up"><i class="bi bi-arrow-up-right"></i><%= o.server_name %></div>
                      <% } else { %>
                        <div class="odps-badge none"><i class="bi bi-dash-circle"></i><%= t('admin.map.form.no_uplink', 'Tanpa induk') %></div>
                      <% } %>
                      <% if (o.description) { %>
                        <div class="odps-desc"><%= o.description %></div>
                      <% } %>
                    </td>
                    <td class="odps-hide-sm">
                      <div class="odps-coord"><%= (Number(o.lat) || 0).toFixed(6) %>, <%= (Number(o.lng) || 0).toFixed(6) %></div>
                    </td>
                    <td>
                      <div class="odps-actions">
                        <button type="button" class="btn btn-sm btn-p" data-odp-id="<%= Number(o.id) %>" onclick="editOdpFromBtn(this)" title="<%= t('common.edit', 'Edit') %>"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="btn btn-sm btn-d" data-odp-id="<%= Number(o.id) %>" onclick="deleteOdpFromBtn(this)" title="Hapus"><i class="bi bi-trash"></i></button>
