<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin.invoice.title', 'Invoice') %> INV-<%= String(invoice.id).padStart(5,'0') %> — <%= customer.name %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink:      #0f172a;
      --ink-soft: #475569;
      --muted:    #94a3b8;
      --line:     #e2e8f0;
      --line-2:   #f1f5f9;
      --accent:   #2563eb;
      --paid:     #059669;
      --unpaid:   #dc2626;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #eef2f7;
      color: var(--ink);
      font-size: 13px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      padding: 24px 16px 60px;
    }

    /* ─── Toolbar (layar saja, tidak ikut tercetak) ─── */
    .toolbar {
      max-width: 210mm; margin: 0 auto 16px;
      display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap;
    }
    .tb-btn {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 9px 16px; border-radius: 9px; border: 1px solid var(--line);
      background: #fff; color: var(--ink); font-size: 13px; font-weight: 600;
      font-family: inherit; cursor: pointer; text-decoration: none;
      box-shadow: 0 1px 2px rgba(15,23,42,.05); transition: all .15s;
    }
    .tb-btn:hover { border-color: var(--accent); color: var(--accent); }
    .tb-btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .tb-btn.primary:hover { background: #1d4ed8; color: #fff; }

    /* ─── Lembar A4 ─── */
    .sheet {
      width: 210mm; min-height: 297mm; margin: 0 auto; background: #fff;
      padding: 16mm 15mm; position: relative; overflow: hidden;
      box-shadow: 0 10px 40px rgba(15,23,42,.12); border-radius: 4px;
    }

    /* ─── Header ─── */
    .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; }
    .brand { display: flex; gap: 14px; align-items: flex-start; min-width: 0; }
    .brand-logo { width: 54px; height: 54px; object-fit: contain; flex-shrink: 0; }
    .brand-fallback {
      width: 54px; height: 54px; border-radius: 12px; flex-shrink: 0;
      background: var(--accent); color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px; font-weight: 800; letter-spacing: -.5px;
    }
    .brand-text { min-width: 0; }
    .brand-name { font-size: 17px; font-weight: 800; letter-spacing: -.3px; line-height: 1.25; }
    .brand-meta { font-size: 11px; color: var(--ink-soft); margin-top: 3px; line-height: 1.6; }

    .doc { text-align: right; flex-shrink: 0; }
    .doc-label {
      font-size: 22px; font-weight: 800; letter-spacing: 3px;
      color: var(--accent); text-transform: uppercase; line-height: 1;
    }
    .doc-no { font-size: 12px; font-weight: 700; margin-top: 7px; letter-spacing: .3px; }
    .doc-date { font-size: 11px; color: var(--ink-soft); margin-top: 2px; }

    .rule { height: 2px; background: var(--ink); margin: 16px 0 0; }
    .rule-soft { height: 1px; background: var(--line); margin: 18px 0; }

    /* ─── Blok info ─── */
    .info { display: flex; gap: 28px; margin-top: 20px; }
    .info-col { flex: 1; min-width: 0; }
    .info-col.narrow { flex: 0 0 38%; }
    .cap {
      font-size: 9.5px; font-weight: 700; letter-spacing: 1.1px;
      text-transform: uppercase; color: var(--muted); margin-bottom: 7px;
    }
    .party-name { font-size: 14px; font-weight: 700; line-height: 1.35; }
    .party-line { font-size: 11.5px; color: var(--ink-soft); line-height: 1.65; }

    .kv { display: flex; justify-content: space-between; gap: 12px; font-size: 11.5px; padding: 3px 0; }
    .kv dt { color: var(--ink-soft); }
    .kv dd { font-weight: 600; text-align: right; }

    /* ─── Tabel rincian ─── */
    table.items { width: 100%; border-collapse: collapse; margin-top: 22px; }
    table.items thead th {
      font-size: 9.5px; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase;
      color: var(--muted); text-align: left; padding: 0 0 8px;
      border-bottom: 1.5px solid var(--ink);
    }
    table.items thead th.num { text-align: right; }
    table.items tbody td { padding: 13px 0; border-bottom: 1px solid var(--line-2); vertical-align: top; }
    table.items tbody td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .item-name { font-weight: 600; font-size: 13px; }
    .item-desc { font-size: 11px; color: var(--ink-soft); margin-top: 3px; line-height: 1.5; }
    .item-sub { font-size: 11px; color: var(--ink-soft); }

    /* Sorotan kecepatan paket */
    .speed-badge {
      display: inline-block; margin-top: 7px;
      background: var(--accent); color: #fff;
      font-size: 13px; font-weight: 800; letter-spacing: .6px;
      padding: 5px 13px; border-radius: 7px; white-space: nowrap;
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }

    /* ─── Total ─── */
    .totals { display: flex; justify-content: flex-end; margin-top: 16px; }
    .totals-box { width: 62mm; }
    .tt { display: flex; justify-content: space-between; gap: 16px; font-size: 12px; padding: 5px 0; }
    .tt dt { color: var(--ink-soft); }
    .tt dd { font-variant-numeric: tabular-nums; font-weight: 600; }
    .tt-grand {
      display: flex; justify-content: space-between; gap: 16px; align-items: baseline;
      margin-top: 8px; padding-top: 11px; border-top: 2px solid var(--ink);
    }
    .tt-grand dt { font-size: 11px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; }
    .tt-grand dd { font-size: 19px; font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: -.4px; }

    .terbilang {
      margin-top: 10px; font-size: 10.5px; color: var(--ink-soft);
      font-style: italic; text-align: right;
    }

    /* Penegasan bahwa invoice belum lunas bukan bukti bayar */
    .not-receipt {
      margin-top: 10px; padding: 8px 12px; border-radius: 8px;
      background: #fef2f2; border: 1.5px solid #fca5a5; color: #991b1b;
      font-size: 10px; font-weight: 700; line-height: 1.5;
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }

    .verify-note {
      position: absolute; left: 14mm; right: 14mm; bottom: 6mm;
      font-size: 8.5px; color: var(--ink-soft); text-align: center; line-height: 1.5;
    }

    .overdue-flag {
      display: inline-block; margin-top: 6px; padding: 3px 9px; border-radius: 999px;
      background: #fee2e2; color: var(--unpaid); font-size: 10px; font-weight: 700;
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }

    /* ─── Stempel status ─── */
    .stamp {
      position: absolute; top: 148mm; left: 50%;
      transform: translate(-50%, -50%) rotate(-16deg);
      border: 5px solid var(--paid); color: var(--paid);
      font-size: 46px; font-weight: 800; letter-spacing: 7px;
      padding: 10px 34px; border-radius: 12px; opacity: .13;
      pointer-events: none; white-space: nowrap;
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }
    .stamp.unpaid { border-color: var(--unpaid); color: var(--unpaid); }

    /* ─── Bagian bawah ─── */
    .bottom { display: flex; gap: 24px; margin-top: 26px; align-items: flex-start; }
    .bottom-main { flex: 1; min-width: 0; }
    .pay-box { border: 1px solid var(--line); border-radius: 10px; padding: 13px 15px; }
    .pay-row { display: flex; gap: 14px; align-items: center; }
    .pay-qr {
      width: 82px; height: 82px; object-fit: contain; flex-shrink: 0;
      border: 1px solid var(--line); border-radius: 8px; padding: 4px; background: #fff;
    }
    .pay-lines { min-width: 0; font-size: 11.5px; line-height: 1.7; }
    .pay-bank { font-weight: 700; font-size: 12.5px; }
    .pay-acct { font-variant-numeric: tabular-nums; letter-spacing: .5px; font-weight: 700; font-size: 14px; }

    .sign { flex: 0 0 54mm; text-align: center; }
    /* Kotak tanda tangan: 48mm x 19mm — gambar 600x240 px pas tanpa distorsi */
    .sign-area {
      height: 19mm; display: flex; align-items: flex-end; justify-content: center;
      margin-bottom: 4px;
    }
    .sign-img { max-width: 48mm; max-height: 19mm; object-fit: contain; }
    .sign-placeholder {
      width: 48mm; height: 19mm; border: 1px dashed var(--line);
      border-radius: 6px; display: flex; align-items: center; justify-content: center;
      font-size: 9px; color: var(--muted); text-align: center; line-height: 1.4; padding: 4px;
    }
    .sign-name { font-weight: 700; font-size: 12.5px; border-top: 1px solid var(--ink); padding-top: 6px; }
    .sign-role { font-size: 10.5px; color: var(--ink-soft); margin-top: 2px; }
    .sign-note { font-size: 9px; color: var(--muted); margin-top: 5px; line-height: 1.4; }

    .note-box {
      margin-top: 16px; font-size: 10.5px; color: var(--ink-soft);
      background: var(--line-2); border-radius: 8px; padding: 10px 13px; line-height: 1.65;
    }

    .foot {
      margin-top: 22px; padding-top: 12px; border-top: 1px solid var(--line);
      display: flex; justify-content: space-between; gap: 16px;
      font-size: 10px; color: var(--muted);
    }

    /* ─── Aturan cetak ─── */
    @page { size: A4; margin: 0; }
    @media print {
      body { background: #fff; padding: 0; }
      .toolbar { display: none !important; }

      /* Tinggi dipatok tepat 1 lembar A4 dan footer dipaku ke dasar halaman,
         sehingga footer tidak mungkin terdorong ke halaman berikutnya.
         Jarak vertikal dirapatkan secukupnya agar seluruh isi muat satu
         lembar tanpa membuat tata letak terasa sesak. */
      .sheet {
        width: 210mm; height: 297mm; min-height: 0; margin: 0;
        box-shadow: none; border-radius: 0;
        padding: 12mm 13mm 20mm;
        position: relative;
        /* overflow dibiarkan terlihat: kalau suatu saat isinya benar-benar
           panjang, lebih baik meluber daripada terpotong diam-diam. */
        overflow: visible;
      }

      .foot {
        position: absolute; left: 13mm; right: 13mm; bottom: 9mm;
        margin-top: 0; padding-top: 8px;
      }

      .rule       { margin-top: 13px; }
      .rule-soft  { margin: 12px 0; }
      .info       { margin-top: 14px; }
      .kv         { padding: 2px 0; }
      table.items { margin-top: 15px; }
      table.items tbody td { padding: 9px 0; }
      .speed-badge { margin-top: 5px; padding: 4px 11px; }
      .totals     { margin-top: 10px; }
      .tt         { padding: 4px 0; }
      .tt-grand   { margin-top: 6px; padding-top: 9px; }
      .terbilang  { margin-top: 7px; }
      .pay-exact  { margin-top: 8px; padding: 8px 12px; }
      .pay-box    { padding: 10px 13px; }
      .note-box   { margin-top: 10px; padding: 8px 12px; }
      .bottom     { margin-top: 14px; }
      .sign-area  { height: 16mm; }
      .sign-img   { max-height: 16mm; }
      .sign-placeholder { height: 16mm; }

      /* Jangan pernah memotong blok-blok ini di tengah */
      .info, .totals, .bottom, .sign, .pay-box, .pay-exact, .note-box,
      table.items tbody tr { page-break-inside: avoid; break-inside: avoid; }

      /* Pastikan warna aksen & stempel tetap tercetak */
      .doc-label, .stamp, .speed-badge, .note-box, .pay-box,
      .pay-exact, .overdue-flag {
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
    }
    @media (max-width: 820px) {
      .sheet { width: 100%; padding: 20px 16px; }
      .head, .info, .bottom { flex-direction: column; gap: 16px; }
      .doc { text-align: left; }
      .totals { justify-content: stretch; }
      .totals-box { width: 100%; }
      .sign { flex: 1 1 auto; }
    }
  </style>
</head>
<body>

<%
  const mns = (lang || 'id') === 'en'
    ? ['January','February','March','April','May','June','July','August','September','October','November','December']
    : ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];

  const isPaid   = invoice.status === 'paid';
  const invNo    = 'INV-' + invoice.period_year + String(invoice.period_month).padStart(2,'0') + '-' + String(invoice.id).padStart(5,'0');
  const periode  = (mns[invoice.period_month - 1] || '-') + ' ' + invoice.period_year;
  const rp       = (n) => 'Rp ' + (Number(n) || 0).toLocaleString('id-ID');

  const bd       = locals.breakdown || { taxes: [], adjustments: [], subtotal: invoice.amount };

  // Kecepatan unduh paket dalam Mbps (speed_down disimpan dalam Kbps)
  const speedMbps = (locals.pkg && Number(locals.pkg.speed_down) > 0)
                      ? Math.round(Number(locals.pkg.speed_down) / 1000)
                      : null;

  const phone    = (settings.whatsapp_admin_numbers && settings.whatsapp_admin_numbers.length > 0)
                     ? '+' + settings.whatsapp_admin_numbers[0]
                     : (settings.company_phone || '');

  const bankName = String(settings.invoice_bank_name || '').trim();
  const bankAcct = String(settings.invoice_bank_account || '').trim();
  const bankHold = String(settings.invoice_bank_holder || '').trim();
  const hasBank  = !isPaid && bankAcct !== '';
  const invNote  = String(settings.invoice_note || '').trim();

  // QRIS sengaja TIDAK dicetak di invoice. Nominal unik QRIS berumur pendek dan
  // bisa berubah, sementara invoice kertas beredar lama — mencetaknya justru
  // memancing pembayaran dengan nominal kedaluwarsa yang gagal dicocokkan.
  // Pembayaran QRIS dilayani lewat portal pelanggan / pesan WhatsApp.
  const payAmount = Number(invoice.amount) || 0;

  // Jatuh tempo
  const due       = (typeof dueInfo !== 'undefined') ? dueInfo : null;
  const dueText   = due ? `${String(due.day).padStart(2,'0')} ${mns[due.month - 1]} ${due.year}` : '';
  const isOverdue = !!(due && due.isOverdue);

  // Terbilang sederhana (rupiah, tanpa sen)
  function terbilang(n) {
    n = Math.floor(Math.abs(Number(n) || 0));
    const sat = ['','satu','dua','tiga','empat','lima','enam','tujuh','delapan','sembilan','sepuluh','sebelas'];
    function conv(x) {
      if (x < 12) return sat[x];
      if (x < 20) return conv(x - 10) + ' belas';
      if (x < 100) return conv(Math.floor(x / 10)) + ' puluh' + (x % 10 ? ' ' + conv(x % 10) : '');
      if (x < 200) return 'seratus' + (x - 100 ? ' ' + conv(x - 100) : '');
      if (x < 1000) return conv(Math.floor(x / 100)) + ' ratus' + (x % 100 ? ' ' + conv(x % 100) : '');
      if (x < 2000) return 'seribu' + (x - 1000 ? ' ' + conv(x - 1000) : '');
      if (x < 1000000) return conv(Math.floor(x / 1000)) + ' ribu' + (x % 1000 ? ' ' + conv(x % 1000) : '');
      if (x < 1000000000) return conv(Math.floor(x / 1000000)) + ' juta' + (x % 1000000 ? ' ' + conv(x % 1000000) : '');
      return conv(Math.floor(x / 1000000000)) + ' miliar' + (x % 1000000000 ? ' ' + conv(x % 1000000000) : '');
    }
    if (n === 0) return 'nol';
    const s = conv(n).replace(/\s+/g, ' ').trim();
    return s.charAt(0).toUpperCase() + s.slice(1);
  }
%>

<div class="toolbar">
  <button class="tb-btn primary" onclick="window.print()">🖨 <%= t('admin.invoice.print', 'Cetak / Simpan PDF') %></button>
  <a class="tb-btn" href="/admin/billing/<%= invoice.id %>/print?format=thermal">🧾 <%= t('admin.invoice.print_thermal', 'Cetak Struk Termal') %></a>
  <a class="tb-btn" href="/admin/billing"><%= t('common.back', 'Kembali') %></a>
</div>

<div class="sheet">

  <!-- HEADER -->
  <div class="head">
    <div class="brand">
      <img src="/img/logo.png" alt="" class="brand-logo"
           onerror="this.outerHTML='<div class=\'brand-fallback\'><%= String(company).charAt(0).toUpperCase() %></div>'">
      <div class="brand-text">
        <div class="brand-name"><%= company %></div>
        <div class="brand-meta">
          <% if (settings.company_address) { %><%= settings.company_address %><br><% } %>
          <% if (phone) { %><%= t('admin.invoice.phone', 'Telp/WA') %>: <%= phone %><% } %>
          <% if (settings.company_email) { %> &nbsp;·&nbsp; <%= settings.company_email %><% } %>
        </div>
      </div>
    </div>

    <div class="doc">
      <div class="doc-label"><%= t('admin.invoice.doc_label', 'Invoice') %></div>
      <div class="doc-no"><%= invNo %></div>
      <div class="doc-date">
        <%= t('admin.invoice.issued', 'Diterbitkan') %>:
        <%= invoice.created_at ? formatDateLocal(invoice.created_at) : getNowLocal() %>
      </div>
    </div>
  </div>

  <div class="rule"></div>

  <!-- INFO PELANGGAN & INVOICE -->
  <div class="info">
    <div class="info-col">
      <div class="cap"><%= t('admin.invoice.bill_to', 'Ditagihkan Kepada') %></div>
      <div class="party-name"><%= customer.name %></div>
      <div class="party-line">
        <% if (customer.address) { %><%= customer.address %><br><% } %>
        <% if (customer.phone) { %><%= customer.phone %><% } %>
        <% if (customer.email) { %><br><%= customer.email %><% } %>
      </div>
    </div>

    <div class="info-col narrow">
      <div class="cap"><%= t('admin.invoice.details', 'Rincian Invoice') %></div>
      <dl class="kv"><dt><%= t('admin.invoice.period', 'Periode Layanan') %></dt><dd><%= periode %></dd></dl>
      <% if (dueText) { %>
        <dl class="kv"><dt><%= t('admin.invoice.due_date', 'Jatuh Tempo') %></dt>
          <dd style="color:<%= isOverdue ? 'var(--unpaid)' : 'inherit' %>"><%= dueText %></dd>
        </dl>
      <% } %>
      <dl class="kv"><dt><%= t('admin.invoice.status', 'Status') %></dt>
        <dd style="color:<%= isPaid ? 'var(--paid)' : 'var(--unpaid)' %>">
          <%= isPaid ? t('admin.invoice.paid', 'LUNAS') : (isOverdue ? t('admin.invoice.overdue', 'LEWAT JATUH TEMPO') : t('admin.invoice.unpaid', 'BELUM DIBAYAR')) %>
        </dd>
      </dl>
      <% if (isPaid && invoice.paid_at) { %>
        <dl class="kv"><dt><%= t('admin.invoice.paid_at', 'Tgl Bayar') %></dt><dd><%= formatDateLocal(invoice.paid_at) %></dd></dl>
        <dl class="kv"><dt><%= t('admin.invoice.received_by', 'Diterima Oleh') %></dt><dd><%= invoice.paid_by_name || t('admin.invoice.system', 'Sistem') %></dd></dl>
      <% } %>
    </div>
  </div>

  <!-- RINCIAN -->
  <table class="items">
    <thead>
      <tr>
        <th style="width:56%"><%= t('admin.invoice.description', 'Deskripsi') %></th>
        <th class="num" style="width:14%"><%= t('admin.invoice.qty', 'Jml') %></th>
        <th class="num" style="width:30%"><%= t('admin.invoice.amount', 'Jumlah') %></th>
      </tr>
    </thead>
    <tbody>
      <!-- Baris 1: Biaya bulanan (DPP) -->
      <tr>
        <td>
          <div class="item-name">
            <%= t('admin.invoice.monthly_fee', 'Biaya Bulanan') %><% if (customer.package_name) { %> — <%= customer.package_name %><% } %>
          </div>
          <div class="item-desc"><%= t('admin.invoice.service_period', 'Periode langganan') %>: <%= periode %></div>
          <% if (speedMbps) { %>
            <div><span class="speed-badge">UP TO <%= speedMbps %> Mbps</span></div>
          <% } %>
          <% if (bd.adjustments && bd.adjustments.length > 0) { %>
            <div class="item-desc" style="margin-top:6px">
              <% bd.adjustments.forEach(function(a, i){ %><%= i ? ' · ' : '' %><%= a %><% }) %>
            </div>
          <% } %>
        </td>
        <td class="num">1</td>
        <td class="num"><%= rp(bd.subtotal) %></td>
      </tr>

      <!-- Baris pajak: tampil sebagai baris tersendiri, bukan hanya di totalan -->
      <% bd.taxes.forEach(function(tx){ %>
        <tr>
          <td>
            <div class="item-name"><%= tx.label %></div>
            <div class="item-sub">
              <%= tx.inclusive
                    ? t('admin.invoice.tax_included', 'Sudah termasuk dalam harga paket')
                    : t('admin.invoice.tax_added', 'Dikenakan atas biaya bulanan') %>
            </div>
          </td>
          <td class="num">1</td>
          <td class="num"><%= rp(tx.amount) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <!-- TOTAL -->
  <div class="totals">
    <div class="totals-box">
      <dl class="tt">
        <dt><%= t('admin.invoice.monthly_fee', 'Biaya Bulanan') %></dt>
        <dd><%= rp(bd.subtotal) %></dd>
      </dl>
      <% bd.taxes.forEach(function(tx){ %>
        <dl class="tt"><dt><%= tx.label %></dt><dd><%= rp(tx.amount) %></dd></dl>
      <% }) %>
      <dl class="tt-grand">
        <dt><%= isPaid ? t('admin.invoice.total_paid', 'Total Dibayar') : t('admin.invoice.total_due', 'Total Tagihan') %></dt>
        <dd><%= rp(invoice.amount) %></dd>
      </dl>

      <div class="terbilang"><%= t('admin.invoice.in_words', 'Terbilang') %>: <em><%= terbilang(payAmount) %> rupiah</em></div>
    </div>
  </div>

  <!-- STEMPEL -->
  <div class="stamp <%= isPaid ? '' : 'unpaid' %>">
    <%= isPaid ? t('admin.invoice.stamp_paid', 'LUNAS') : t('admin.invoice.stamp_unpaid', 'BELUM LUNAS') %>
  </div>

  <div class="rule-soft"></div>

  <!-- PEMBAYARAN & TANDA TANGAN -->
  <div class="bottom">
    <div class="bottom-main">
      <% if (hasBank) { %>
        <div class="cap"><%= t('admin.invoice.how_to_pay', 'Cara Pembayaran') %></div>
        <div class="pay-box">
          <div class="pay-row">
            <div class="pay-lines">
              <div class="pay-bank"><%= bankName || t('admin.invoice.transfer', 'Transfer Bank') %></div>
              <div class="pay-acct"><%= bankAcct %></div>
              <% if (bankHold) { %><div><%= t('admin.invoice.on_behalf', 'a.n.') %> <%= bankHold %></div><% } %>
              <% if (dueText) { %>
                <div style="color:var(--ink-soft)"><%= t('admin.invoice.pay_before', 'Bayar sebelum') %> <%= dueText %></div>
              <% } %>
              <% if (phone) { %>
                <div style="color:var(--ink-soft)"><%= t('admin.invoice.confirm_to', 'Konfirmasi pembayaran ke') %> <%= phone %></div>
              <% } %>
              <% if (isOverdue) { %>
                <div class="overdue-flag">
                  <%= t('admin.invoice.overdue_warn', 'Sudah lewat jatuh tempo — layanan dapat diisolir') %>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% } else if (isPaid) { %>
        <div class="cap"><%= t('admin.invoice.payment_status', 'Status Pembayaran') %></div>
        <div class="pay-box">
          <div class="pay-lines">
            <div class="pay-bank" style="color:var(--paid)"><%= t('admin.invoice.settled', 'Tagihan ini telah lunas.') %></div>
            <div style="color:var(--ink-soft)">
              <%= t('admin.invoice.keep_doc', 'Dokumen ini sah sebagai bukti pembayaran tanpa memerlukan tanda tangan basah.') %>
            </div>
          </div>
        </div>
      <% } %>

      <%
        // Peringatan tegas untuk invoice yang BELUM lunas. Tanpa ini, dokumen
        // beramplop resmi dan berlogo mudah disalahartikan — atau sengaja
        // dipakai — sebagai bukti pembayaran.
      %>
      <% if (!isPaid) { %>
        <div class="not-receipt">
          <%= t('admin.invoice.not_a_receipt', 'Dokumen ini BUKAN bukti pembayaran. Tagihan masih berstatus BELUM LUNAS.') %>
        </div>
      <% } %>

      <% if (invNote) { %>
        <div class="note-box"><%= invNote %></div>
      <% } %>
    </div>

    <div class="sign">
      <div class="cap"><%= t('admin.invoice.authorized', 'Hormat Kami') %></div>
      <div class="sign-area">
        <!-- Ganti file public/img/signature.png dengan tanda tangan Anda.
             Bila file belum ada, kotak putus-putus di bawah yang tampil. -->
        <img src="/img/signature.png" alt="" class="sign-img"
             onerror="this.outerHTML='<div class=\'sign-placeholder\'><%= t('admin.invoice.sign_placeholder', 'Area Tanda Tangan') %><br>600 &times; 240 px</div>'">
      </div>
      <div class="sign-name"><%= settings.company_manager || company %></div>
      <div class="sign-role"><%= t('admin.invoice.manager', 'Manajer') %></div>
      <div class="sign-note"><%= t('admin.invoice.sign_note', 'Ditandatangani secara digital') %></div>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="foot">
    <div>
      <%= settings.footer_info || company %>
      <% if (settings.operational_hours) { %> · <%= settings.operational_hours %><% } %>
    </div>
    <div>
      <%= invNo %> · <%= t('admin.invoice.printed_on', 'Dicetak') %> <%= getNowLocal() %>
      <% if (locals.verifyCode) { %>
        · <%= t('admin.invoice.verify_code', 'Kode Verifikasi') %>:
        <strong style="letter-spacing:.5px"><%= locals.verifyCode %></strong>
      <% } %>
    </div>
  </div>

  <% if (locals.verifyCode && locals.issuedToCustomer) { %>
    <%
      // Dicetak sendiri oleh pelanggan. Kode verifikasi mengikat nomor,
      // nominal, dan status — bila salah satunya disunting, kode tidak lagi
      // cocok saat dicek petugas. Keasliannya jadi bisa dibuktikan.
    %>
    <div class="verify-note">
      <%= t('admin.invoice.verify_hint',
            'Keaslian dokumen dapat diperiksa ke petugas dengan menyebutkan nomor invoice beserta kode verifikasi di atas.') %>
    </div>
  <% } %>

</div>

<script>
  // Cetak otomatis bila dibuka dengan ?autoprint=1
  if (new URLSearchParams(location.search).get('autoprint') === '1') {
    window.addEventListener('load', () => setTimeout(() => window.print(), 400));
  }
</script>
</body>
</html>
