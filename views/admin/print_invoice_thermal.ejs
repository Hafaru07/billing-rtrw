<%
  const BASE = (locals.basePath || '/admin/billing').replace(/\/+$/, '');
  const BACK = locals.backUrl || '/admin/billing';
%>
<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('admin.thermal.title', 'Cetak Struk Thermal') %> #<%= invoice.id %></title>
  <style>
    :root {
      --bg: #f1f5f9; --card: #fff; --ink: #0f172a; --muted: #64748b;
      --line: #e2e8f0; --brand: #2563eb; --brand-ink: #fff;
      --ok: #16a34a; --warn: #b45309; --warn-bg: #fffbeb; --err: #dc2626;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 16px; background: var(--bg); color: var(--ink);
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      font-size: 15px; line-height: 1.5;
    }
    .wrap { max-width: 780px; margin: 0 auto; display: grid; gap: 16px; }
    .card {
      background: var(--card); border: 1px solid var(--line); border-radius: 14px;
      padding: 18px; box-shadow: 0 1px 3px rgba(15, 23, 42, .06);
    }
    h1 { margin: 0 0 4px; font-size: 19px; }
    .sub { margin: 0 0 16px; color: var(--muted); font-size: 13.5px; }

    .field { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
    .field label { font-weight: 600; font-size: 14px; }
    select {
      padding: 9px 12px; border: 1px solid var(--line); border-radius: 9px;
      font: inherit; background: #fff; min-width: 130px;
    }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 12px 18px; border-radius: 10px; border: 1px solid var(--line);
      background: #fff; color: var(--ink); font: inherit; font-weight: 600;
      cursor: pointer; text-decoration: none;
    }
    .btn:disabled { opacity: .55; cursor: not-allowed; }
    .btn-primary {
      background: var(--brand); border-color: var(--brand); color: var(--brand-ink);
      width: 100%; padding: 16px; font-size: 17px;
    }
    .btn-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
    .btn-row .btn { flex: 1 1 auto; }

    .status { margin-top: 12px; font-size: 14px; min-height: 22px; }
    .status.ok { color: var(--ok); }
    .status.err { color: var(--err); }
    .status.busy { color: var(--muted); }

    /* Banner hasil aksi sebelumnya (mis. notifikasi WhatsApp setelah bayar) */
    .notice-card { font-weight: 600; font-size: 14.5px; padding: 14px 16px; }
    .notice-card.is-ok   { background: #f0fdf4; border-color: #bbf7d0; color: #15803d; }
    .notice-card.is-warn { background: var(--warn-bg); border-color: #fde68a; color: var(--warn); }

    .notice {
      margin-top: 14px; padding: 12px 14px; border-radius: 10px;
      background: var(--warn-bg); border: 1px solid #fde68a; color: var(--warn);
      font-size: 13.5px;
    }
    .notice a { color: inherit; font-weight: 600; }
    .notice ol { margin: 8px 0 0; padding-left: 20px; }
    .notice li { margin-bottom: 4px; }

    /* Pratinjau: lebarnya dikunci ke jumlah kolom kertas memakai satuan `ch`,
       sehingga apa yang terlihat benar-benar sama dengan yang tercetak. */
    .paper-wrap { display: flex; justify-content: center; }
    .paper {
      background: #fff; border: 1px solid var(--line); border-radius: 4px;
      padding: 10px 12px; box-shadow: 0 2px 10px rgba(15, 23, 42, .09);
      overflow-x: auto; max-width: 100%;
    }
    #preview {
      margin: 0; font-family: "Courier New", Courier, monospace;
      font-size: 12px; line-height: 1.35; white-space: pre; color: #000;
      width: 48ch;
    }

    @media print {
      body { background: #fff; padding: 0; margin: 0; }
      .no-print { display: none !important; }
      .paper {
        border: none; box-shadow: none; border-radius: 0;
        padding: 0; margin: 0; overflow: visible; max-width: none;
      }
      .paper-wrap { display: block; }
      #preview { font-size: 10pt; }
    }
  </style>
  <!-- Ukuran halaman cetak mengikuti pilihan lebar kertas -->
  <style id="page-style">@page { size: 80mm auto; margin: 3mm; }</style>
</head>
<body>
  <div class="wrap">
    <% if (locals.notice && notice.text) { %>
      <div class="card no-print notice-card <%= notice.type === 'ok' ? 'is-ok' : 'is-warn' %>">
        <%= notice.type === 'ok' ? '✅' : '⚠️' %> <%= notice.text %>
      </div>
    <% } %>

    <div class="card no-print">
      <h1><%= t('admin.thermal.title', 'Cetak Struk Thermal') %></h1>
      <p class="sub" id="doc-label"><%= t('common.loading', 'Memuat…') %></p>

      <div class="field">
        <label for="paper-width"><%= t('admin.thermal.paper_width', 'Lebar kertas') %></label>
        <select id="paper-width">
          <option value="80">80 mm (48 kolom)</option>
          <option value="58">58 mm (32 kolom)</option>
        </select>
        <label style="font-weight:500;font-size:13.5px;color:var(--muted)">
          <input type="checkbox" id="with-logo" checked>
          <%= t('admin.thermal.with_logo', 'Sertakan logo') %>
        </label>
      </div>

      <button class="btn btn-primary" id="btn-thermal" disabled>
        🖨 <%= t('admin.thermal.print_now', 'Cetak ke Printer Thermal') %>
      </button>

      <div class="status busy" id="status"><%= t('common.loading', 'Memuat…') %></div>

      <div class="notice" id="install-hint" hidden>
        <strong><%= t('admin.thermal.rawbt_missing', 'Printer tidak merespons?') %></strong>
        <%= t('admin.thermal.rawbt_need', 'Struk dikirim lewat aplikasi RawBT. Kalau belum terpasang, tidak akan terjadi apa-apa saat tombol ditekan.') %>
        <ol>
          <li>
            <%= t('admin.thermal.rawbt_step1', 'Pasang') %>
            <a href="https://play.google.com/store/apps/details?id=ru.a402d.rawbtprinter" target="_blank" rel="noopener">RawBT Print Service</a>
            <%= t('admin.thermal.rawbt_step1b', 'dari Play Store.') %>
          </li>
          <li><%= t('admin.thermal.rawbt_step2', 'Pasangkan (pair) printer Bluetooth 80mm lewat Pengaturan Bluetooth Android.') %></li>
          <li><%= t('admin.thermal.rawbt_step3', 'Buka RawBT sekali, pilih printer tersebut sebagai perangkat aktif.') %></li>
          <li><%= t('admin.thermal.rawbt_step4', 'Kembali ke halaman ini, tekan tombol cetak lagi.') %></li>
        </ol>
      </div>

      <div class="btn-row">
        <button class="btn" id="btn-browser">🖨 <%= t('admin.thermal.print_browser', 'Cetak lewat dialog browser') %></button>
        <a class="btn" id="lnk-raw" href="#" download>⬇ <%= t('admin.thermal.download_raw', 'Unduh .bin') %></a>
        <a class="btn" href="<%= BASE %>/<%= invoice.id %>/print"><%= t('admin.thermal.a4', 'Invoice A4') %></a>
        <a class="btn" href="<%= BACK %>"><%= t('common.back', 'Kembali') %></a>
      </div>
    </div>

    <div class="paper-wrap">
      <div class="paper"><pre id="preview"><%= t('common.loading', 'Memuat…') %></pre></div>
    </div>
  </div>

  <script>
    // Teks UI disuntik sebagai JSON, bukan ditempel satu per satu ke dalam
    // string JavaScript. Keluaran EJS yang di-escape HTML akan mengubah
    // apostrof pada terjemahan menjadi entitas dan merusak skrip ini.
    //
    // "<" ikut di-escape supaya terjemahan yang memuat penutup tag tidak bisa
    // keluar dari blok script.
    var I18N = <%- JSON.stringify({
      building: t('admin.thermal.building', 'Menyiapkan data cetak…'),
      ready:    t('admin.thermal.ready', 'Siap dikirim ke printer.'),
      sending:  t('admin.thermal.sending', 'Mengirim ke RawBT…'),
      sent:     t('admin.thermal.sent', 'Terkirim ke RawBT.'),
      noApp:    t('admin.thermal.no_app', 'RawBT tidak merespons.'),
      failed:   t('admin.thermal.failed', 'Gagal:'),
      cols:     t('admin.thermal.cols', 'kolom'),
      prepFail: t('admin.thermal.prep_failed', 'Gagal menyiapkan struk')
    }).replace(/</g, '\\u003C') %>;

    (function () {
      var INVOICE_ID = <%= Number(invoice.id) %>;
      var BASE_PATH = <%- JSON.stringify(BASE) %>;
      var STORE_KEY = 'thermal.paperWidth';

      var elWidth   = document.getElementById('paper-width');
      var elLogo    = document.getElementById('with-logo');
      var elPrint   = document.getElementById('btn-thermal');
      var elBrowser = document.getElementById('btn-browser');
      var elRaw     = document.getElementById('lnk-raw');
      var elStatus  = document.getElementById('status');
      var elPreview = document.getElementById('preview');
      var elLabel   = document.getElementById('doc-label');
      var elHint    = document.getElementById('install-hint');
      var elPage    = document.getElementById('page-style');

      var current = null;   // { b64, preview, cols, bytes, invoiceNo }

      // Lebar kertas terakhir diingat: kasir memakai printer yang sama tiap
      // hari, tidak masuk akal memilihnya ulang setiap cetak.
      try {
        var saved = localStorage.getItem(STORE_KEY);
        if (saved === '58' || saved === '80') elWidth.value = saved;
      } catch (e) { /* mode privat / storage diblokir — pakai bawaan */ }

      function setStatus(text, kind) {
        elStatus.textContent = text;
        elStatus.className = 'status' + (kind ? ' ' + kind : '');
      }

      function endpoint(extra) {
        return BASE_PATH + '/' + INVOICE_ID + '/escpos'
             + '?width=' + encodeURIComponent(elWidth.value)
             + '&logo=' + (elLogo.checked ? '1' : '0')
             + (extra || '');
      }

      function load() {
        elPrint.disabled = true;
        setStatus(I18N.building, 'busy');

        fetch(endpoint(), { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (!data || !data.ok) throw new Error((data && data.error) || I18N.prepFail);
            current = data;

            elPreview.textContent = data.preview;
            elPreview.style.width = data.cols + 'ch';
            elLabel.textContent = data.invoiceNo + ' · ' + data.cols + ' ' + I18N.cols + ' · ' + data.bytes + ' byte';
            elRaw.href = endpoint('&raw=1');
            elRaw.setAttribute('download', data.invoiceNo + '.bin');

            // Ukuran halaman untuk jalur cetak browser ikut lebar terpilih
            elPage.textContent = '@page { size: ' + elWidth.value + 'mm auto; margin: 3mm; }';

            elPrint.disabled = false;
            setStatus(I18N.ready, 'ok');
          })
          .catch(function (err) {
            current = null;
            elPreview.textContent = '';
            setStatus(I18N.failed + ' ' + err.message, 'err');
          });
      }

      /**
       * Kirim ke RawBT lewat skema URL `rawbt:`.
       *
       * Browser tidak memberi tahu apakah sebuah skema kustom berhasil
       * ditangani. Yang bisa diandalkan: kalau aplikasi terbuka, halaman ini
       * kehilangan fokus. Bila setelah 1,5 detik halaman masih terlihat,
       * hampir pasti RawBT belum terpasang — barulah petunjuk dimunculkan.
       */
      function sendToRawBT(b64) {
        var leftPage = false;
        function onHide() { if (document.hidden) leftPage = true; }
        document.addEventListener('visibilitychange', onHide);
        window.addEventListener('blur', onHide);

        setStatus(I18N.sending, 'busy');
        elHint.hidden = true;

        try {
          window.location.href = 'rawbt:base64,' + b64;
        } catch (e) {
          setStatus(I18N.failed + ' ' + e.message, 'err');
        }

        setTimeout(function () {
          document.removeEventListener('visibilitychange', onHide);
          window.removeEventListener('blur', onHide);
          if (leftPage) {
            setStatus(I18N.sent, 'ok');
          } else {
            setStatus(I18N.noApp, 'err');
            elHint.hidden = false;
          }
        }, 1500);
      }

      elPrint.addEventListener('click', function () {
        if (!current) return;
        sendToRawBT(current.b64);
      });

      elBrowser.addEventListener('click', function () { window.print(); });

      elWidth.addEventListener('change', function () {
        try { localStorage.setItem(STORE_KEY, elWidth.value); } catch (e) {}
        load();
      });
      elLogo.addEventListener('change', load);

      // Bukan Android: RawBT hanya ada di Android, beri tahu sejak awal
      // supaya tidak ditekan berulang kali tanpa hasil.
      if (!/Android/i.test(navigator.userAgent)) {
        elHint.hidden = false;
      }

      load();
    })();
  </script>
</body>
</html>
